# Environment: development / production
ENVIRONMENT=development

# Server
API_HOST=0.0.0.0
API_PORT=8000

# Database (MySQL)
DATABASE_URL=mysql+pymysql://supermarket:change-me-app-password@localhost:3306/supermarket_db?charset=utf8mb4
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# JWT Auth (Key MUST be at least 32 characters)
JWT_SECRET_KEY=change-me-to-a-very-secure-random-32-byte-secret-key-at-least
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=SupermarketAPI
JWT_AUDIENCE=SupermarketApp

# Delivery rules
DELIVERY_FLAT_FEE=1.50
DELIVERY_FREE_THRESHOLD=20.00
STORE_CURRENCY=USD

# Order & Payment rules
UNPAID_ORDER_EXPIRY_MINUTES=30
ENABLE_SANDBOX_PAYMENTS=true

# Rate Limits (SlowAPI format, e.g. "10/minute", "60/minute")
AUTH_RATE_LIMIT=10/minute
PAYMENT_CHECK_RATE_LIMIT=60/minute

# Bakong KHQR settings (optional, enable when Bakong credentials are ready)
BAKONG_ENABLED=false
BAKONG_BASE_URL=https://api-bakong.nbc.gov.kh
BAKONG_TOKEN=
BAKONG_ACCOUNT_ID=
BAKONG_ACCOUNT_TYPE=Merchant
BAKONG_MERCHANT_NAME=Blue Panda
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_CURRENCY=USD
BAKONG_POLL_INTERVAL_SECONDS=5
BAKONG_PROXY_URL=

